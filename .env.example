# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use for agent reasoning.
# Gemini model to use for agent reasoning.
# Primary: gemini-3.8-flash | Fallbacks: gemini-3.5-flash-lite, gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.8-flash

# Local Redis:   redis://localhost:6379/0
# Upstash TLS:   rediss://default:<token>@<host>.upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# Fallback AI (Groq / Grok)
# Get your key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional screenshot-based visual reasoning (xAI Grok Vision).
# When configured, the agent sends each captured Chrome screenshot + DOM context to Grok.
XAI_API_KEY=your_xai_api_key_here
XAI_VISION_MODEL=grok-2-vision-1212
# Avoid repeated/rapid VLM image requests and oversized payloads.
XAI_VISION_MIN_INTERVAL_SECONDS=3
XAI_VISION_MAX_IMAGE_BYTES=4000000
# Comma-separated frontend origins allowed to call the backend (no trailing slash).
# Add your deployed Vercel frontend origin here in the hosting dashboard.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# My Context — Neon Hosted PostgreSQL Database Persistence
# Application runtime uses Neon's pooled connection endpoint (-pooler)
DATABASE_URL=postgresql+asyncpg://<username>:<password>@<neon-endpoint>-pooler.region.neon.tech/<dbname>?ssl=require

# Direct connection endpoint for Alembic migrations (bypasses transaction pooler)
DIRECT_DATABASE_URL=postgresql+asyncpg://<username>:<password>@<neon-endpoint>.region.neon.tech/<dbname>?ssl=require

# Developer identifier for shared Neon database partitioning.
# When multiple developers connect to the same shared hosted Neon database,
# setting this variable (e.g. APP_USER_ID=deeksha) isolates your profile, documents,
# and memories so developers do not overwrite or share each other's test data.
# If unset in local development, the backend auto-assigns 'dev_<system_user>' with a warning.
# In production, this setting is ignored and verified user sessions are strictly enforced.
APP_USER_ID=your_developer_name

DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT=30

# Authentication & Session Security (Issue 2)
# The backend uses opaque cryptographically random session tokens (not JWT).
# AGENT_SERVER_SECRET is optional: used for server-side HMAC signing.
# If unset, a random 256-bit secret is auto-generated on each backend startup.
# To generate a persistent secret: python -c "import secrets; print(secrets.token_hex(32))"
# AGENT_SERVER_SECRET=your_32_byte_hex_secret_here

# Optional single-user programmatic bootstrap token for headless/scripted session minting.
# If unset, auto-generated on startup and stored in the system temp directory (.agent_bootstrap_token).
# To generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# AGENT_BOOTSTRAP_TOKEN=your_bootstrap_token_here
